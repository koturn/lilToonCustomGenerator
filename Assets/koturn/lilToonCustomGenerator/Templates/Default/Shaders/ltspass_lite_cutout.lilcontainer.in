Shader "Hidden/*LIL_SHADER_NAME*/ltspass_lite_cutout"
{
    HLSLINCLUDE
        //----------------------------------------------------------------------------------------------------------------------
        // Macro

        // Rendering mode
        // 0 : Opaque
        // 1 : Cutout
        // 2 : Transparent
        #define LIL_RENDER 1

        #include "custom.hlsl"
    ENDHLSL

!!ifnotempty:SHOULD_GENERATE_INSERT!!
    lilSubShaderInsert "lilCustomShaderInsert.lilblock"
!!endif!!
!!ifnotempty:SHOULD_GENERATE_INSERT_POST!!
    lilSubShaderInsertPost "lilCustomShaderInsertPost.lilblock"
!!endif!!
    lilSubShaderBRP "DefaultLite"
!!ifnotempty:SUPPORT_LWRP!!
    lilSubShaderLWRP "DefaultLite"
!!endif!!
    lilSubShaderURP "DefaultLite"
    lilSubShaderHDRP "DefaultLite"

    CustomEditor "*LIL_EDITOR_NAME*"
}
