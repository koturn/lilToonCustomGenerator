// #define USE_EXPRESSION_TREE

using System;
using System.Collections.Generic;
using System.IO;
#if USE_EXPRESSION_TREE
using System.Linq.Expressions;
#endif  // USE_EXPRESSION_TREE
using System.Reflection;
#if !USE_EXPRESSION_TREE
using System.Reflection.Emit;
#endif  // !USE_EXPRESSION_TREE
using System.Text;
using UnityEditor;
using UnityEngine;
using lilToon;


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// Additional Portable Object file loader for <see cref="lilLanguageManager"/>.
    /// </summary>
!!endif!!
    internal static class LocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback language name.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reflection result delegate to get current selected language name.
        /// </summary>
!!endif!!
        private static Func<string> _getLanguageName;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, LocalizationCache> _cacheDict = new Dictionary<string, LocalizationCache>();


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load Portable Object file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidPoDir">GUID of portable object directory.</param>
!!endif!!
        public static void Load(string guidPoDir)
        {
            Load(guidPoDir, GetLanguageName());
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load Portable Object file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidPoDir">GUID of portable object directory.</param>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string guidPoDir, string langName)
        {
            var dirAssetPath = AssetDatabase.GUIDToAssetPath(guidPoDir);
            var localeCode = ToLocaleCode(langName);

            //
            // Update fallback cache if needed.
            //
            if (localeCode != FallbackLocaleCode)
            {
                var fallbackFileAssetPath = dirAssetPath + "/" + FallbackLocaleCode + ".po";

                if (!_cacheDict.TryGetValue(localeCode, out var fallbackCache))
                {
                    fallbackCache = new LocalizationCache(Path.GetFullPath(fallbackFileAssetPath));
                }
                else if (fallbackCache.LastWriteTime == new FileInfo(fallbackFileAssetPath).LastWriteTime)
                {
                    fallbackCache = null;
                }

                if (fallbackCache != null && File.Exists(fallbackFileAssetPath))
                {
                    LoadPortableObject(fallbackFileAssetPath, fallbackCache.LocalizationDict);
                }
            }

            var fileAssetPath = dirAssetPath + "/" + localeCode + ".po";

            //
            // Search cache.
            //
            if (_cacheDict.TryGetValue(localeCode, out var cache)
                && cache.LastWriteTime == new FileInfo(fileAssetPath).LastWriteTime
                && cache.FilePath == Path.GetFullPath(fileAssetPath))
            {
                InjectLocalizationDict(cache.LocalizationDict);
                return;
            }

            //
            // Create cache and inject it.
            //
            if (File.Exists(fileAssetPath))
            {
                var newCache = new LocalizationCache(Path.GetFullPath(fileAssetPath));
                LoadPortableObject(fileAssetPath, newCache.LocalizationDict);
                InjectLocalizationDict(newCache.LocalizationDict);
                _cacheDict[localeCode] = newCache;
            }
            else if (_cacheDict.TryGetValue(FallbackLocaleCode, out var fallbackCache))
            {
                InjectLocalizationDict(fallbackCache.LocalizationDict);
            }
        }


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!endif!!
        private static Dictionary<string, string> GetLoc()
        {
            // lilLanguageManager implemented in lilToon 1.3.0.
            var tLilToonInspector = typeof(lilToonInspector);
            var tLilLanguageManager = tLilToonInspector.Assembly.GetType("lilToon.lilLanguageManager");
            return (Dictionary<string, string>)(tLilLanguageManager ?? tLilToonInspector)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get current selected language name.
        /// </summary>
        /// <returns>Selected language name.</returns>
!!endif!!
        private static string GetLanguageName()
        {
            return (_getLanguageName ?? (_getLanguageName = CreateGetLanguageNameFunc()))();
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilToonInspector.edSet.languageName</c> or <c>lilLanguageManager.langSet.languageName</c>.
        /// </summary>
        /// <returns>A delegate that returns current selected language name.</returns>
!!endif!!
        private static Func<string> CreateGetLanguageNameFunc()
        {
            var tLilToonInspector = typeof(lilToonInspector);
            var tLilLanguageManager = tLilToonInspector.Assembly.GetType("lilToon.lilLanguageManager");
            return tLilLanguageManager == null
                ? CreateGetLanguageNameFuncFromLilToonInspector(tLilToonInspector)
                : CreateGetLanguageNameFuncFromLilLanguageManager(tLilLanguageManager);
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilToonInspector.edSet.languageName</c>.
        /// </summary>
        /// <param name="tLilToonInspector"><c>typeof(lilToonInspector)</c></param>
        /// <returns>A delegate that returns <c>lilToonInspector.edSet.languageName</c>.</returns>
        /// <exception cref="MissingFieldException">Thrown when neither <c>lilToonInspector.edSet</c>
        /// nor <c>lilToonInspector.edSet.languageName</c> is found.</exception>
        /// <remarks>
        /// This method is intended for lilToon 1.2.11 and lilToon 1.2.12.
        /// </remarks>
!!endif!!
        private static Func<string> CreateGetLanguageNameFuncFromLilToonInspector(Type tLilToonInspector)
        {
            var fiEdSet = tLilToonInspector.GetField(
                "edSet",
                BindingFlags.Public | BindingFlags.Static);
            if (fiEdSet == null)
            {
                throw new MissingFieldException(tLilToonInspector.FullName, "edSet");
            }

            var tEdSet = fiEdSet.FieldType;
            var fiLanguageName = tEdSet.GetField(
                "languageName",
                BindingFlags.Public | BindingFlags.Instance);
            if (fiLanguageName == null)
            {
                throw new MissingFieldException(tEdSet.FullName, "languageName");
            }

#if USE_EXPRESSION_TREE
            return Expression.Lambda<Func<string>>(
                Expression.Field(
                    Expression.Field(
                        null,
                        fiEdSet),
                    fiLanguageName)).Compile();
#else
                var method = new DynamicMethod(
                    "GetLanguageName",
                    typeof(string),
                    Type.EmptyTypes,
                    typeof(LocalizationInjector),
                    true);

                var il = method.GetILGenerator();

                il.Emit(OpCodes.Ldsfld, fiEdSet);
                il.Emit(OpCodes.Ldfld, fiLanguageName);
                il.Emit(OpCodes.Ret);

                return (Func<string>)method.CreateDelegate(typeof(Func<string>));
#endif  // USE_EXPRESSION_TREE
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilLanguageManager.langSet.languageName</c>.
        /// </summary>
        /// <param name="tLilLanguageManager"><c>typeof(lilLanguageManager)</c></param>
        /// <returns>A delegate that returns <c>lilLanguageManager.langSet.languageName</c>.</returns>
        /// <exception cref="MissingMemberException">Thrown when neither <c>lilLanguageManager.langSet</c>
        /// nor <c>lilLanguageManager.langSet.languageName</c> is not found.</exception>
        /// <exception cref="MissingMethodException">Thrown when the getter method for <c>lilLanguageManager.langSet</c>
        /// or <c>lilLanguageManager.langSet.languageName</c> is not found.</exception>
        /// <remarks>
        /// This method is intended for lilToon 1.3.0 and later.
        /// </remarks>
!!endif!!
        private static Func<string> CreateGetLanguageNameFuncFromLilLanguageManager(Type tLilLanguageManager)
        {
            var langSetProperty = tLilLanguageManager.GetProperty(
                "langSet",
                BindingFlags.Public | BindingFlags.Static);
            if (langSetProperty == null)
            {
                throw new MissingMemberException(tLilLanguageManager.FullName, "langSet");
            }

            var tLanguageSettings = langSetProperty.PropertyType;
            var piLanguageName = tLanguageSettings.GetProperty(
                "languageName",
                BindingFlags.Public | BindingFlags.Instance);
            if (piLanguageName == null)
            {
                throw new MissingMemberException(tLanguageSettings.FullName, "languageName");
            }

#if USE_EXPRESSION_TREE
            return Expression.Lambda<Func<string>>(
                Expression.Property(
                    Expression.Property(
                        null,
                        langSetProperty),
                    piLanguageName),
                "GetLanguageName",
                null).Compile();
#else
                var langSetGetter = langSetProperty.GetGetMethod();
                if (langSetGetter == null)
                {
                    throw new MissingMethodException(tLilLanguageManager.FullName, "get_langSet");
                }

                var miLanguageNameGetter = piLanguageName.GetGetMethod();
                if (miLanguageNameGetter == null)
                {
                    throw new MissingMethodException(tLanguageSettings.FullName, "get_languageName");
                }

                var method = new DynamicMethod(
                    "GetLanguageName",
                    typeof(string),
                    Type.EmptyTypes,
                    typeof(LocalizationInjector),
                    true);

                var il = method.GetILGenerator();

                il.Emit(OpCodes.Call, langSetGetter);
                il.Emit(OpCodes.Call, miLanguageNameGetter);
                il.Emit(OpCodes.Ret);

                return (Func<string>)method.CreateDelegate(typeof(Func<string>));
#endif
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
        private static string ToLocaleCode(string langName)
        {
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load portable object to the specified dictionary.
        /// </summary>
        /// <param name="fileAssetPath">Portable Object asset file path.</param>
        /// <param name="localizationDict">Localization dictionary to load.</param>
        /// <exception cref="FileNotFoundException">Thrown when <paramref name="fileAssetPath"/> is not found.</exception>
!!endif!!
        private static void LoadPortableObject(string fileAssetPath, Dictionary<string, string> localizationDict)
        {
            if (!File.Exists(fileAssetPath))
            {
                throw new FileNotFoundException("Portable object file not found", fileAssetPath);
            }

            var localizationAsset = AssetDatabase.LoadAssetAtPath<LocalizationAsset>(fileAssetPath);
            var msgIdList = ReadMsgIds(fileAssetPath);

            localizationDict.Clear();
            foreach (var msgId in msgIdList)
            {
                localizationDict[msgId] = localizationAsset.GetLocalizedString(msgId);
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Inject localization dictionary to <see cref="_loc"/>.
        /// </summary>
        /// <param name="localizationDict">Localization dictionary.</param>
!!endif!!
        private static void InjectLocalizationDict(Dictionary<string, string> localizationDict)
        {
            var loc = _loc;
            if (_cacheDict.TryGetValue(FallbackLocaleCode, out var fallbackCache))
            {
                var fallbackLocalizationDict = fallbackCache.LocalizationDict;
                foreach (var kv in localizationDict)
                {
                    string val;
                    if (kv.Key != kv.Value)
                    {
                        val = kv.Value;
                    }
                    else if (!fallbackLocalizationDict.TryGetValue(kv.Key, out val))
                    {
                        val = kv.Key;
                    }
                    loc[kv.Key] = val;
                }
            }
            else
            {
                foreach (var kv in localizationDict)
                {
                    loc[kv.Key] = kv.Value;
                }
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Read all msgid from specified Portable Object file.
        /// </summary>
        /// <param name="fileAssetPath">Target Portable Object asset path.</param>
        /// <returns><see cref="List{T}"/> of msgid.</returns>
!!endif!!
        private static List<string> ReadMsgIds(string fileAssetPath)
        {
            var msgIdList = new List<string>();
            using (var reader = new StreamReader(fileAssetPath, Encoding.UTF8))
            {
                var sb = new StringBuilder();
                var isReadingMsgId = false;

                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    if (line.StartsWith("msgid ", StringComparison.Ordinal))
                    {
                        // If the previous msgid was not terminated.
                        if (isReadingMsgId && sb.Length > 0)
                        {
                            msgIdList.Add(sb.ToString());
                        }
                        sb.Clear();

                        isReadingMsgId = true;
                        AppendQuotedString(sb, line, 6);
                        continue;
                    }

                    if (!isReadingMsgId)
                    {
                        continue;
                    }

                    var trimmed = line.Trim();

                    // Continuation of the msgid line
                    if (IsQuotedString(trimmed))
                    {
                        AppendQuotedString(sb, trimmed, 0);
                        continue;
                    }

                    // End of msgid
                    isReadingMsgId = false;

                    // msgid "" is a PO header
                    if (sb.Length > 0)
                    {
                        msgIdList.Add(sb.ToString());
                    }

                    sb.Clear();
                }

                // EOF
                if (isReadingMsgId && sb.Length > 0)
                {
                    msgIdList.Add(sb.ToString());
                }
            }

            return msgIdList;
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Check whether the specified string is enclosed in double quotes.
        /// </summary>
        /// <param name="text">Target string.</param>
        /// <returns>True if specified string is enclosed in double quotes, false otherwise.</returns>
!!endif!!
        private static bool IsQuotedString(string text)
        {
            var length = text.Length;
            return length >= 2 && text[0] == '"' && text[length - 1] == '"';
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Decodes a PO string in the “...” format and adds it to the builder.
        /// </summary>
        /// <param name="sb"></param>
        /// <param name="quotedText"></param>
        /// <param name="offset"></param>
        /// <exception cref="FormatException">Thrown when a PO file format error is detected.</exception>
!!endif!!
        private static void AppendQuotedString(StringBuilder sb, string quotedText, int offset)
        {
            var length = quotedText.Length;
!!ifempty:ALLOW_UNSAFE_CODE!!
            // Check the leading `"`.
            if (offset >= length || quotedText[offset] != '"')
            {
                throw new FormatException("Invalid PO string: " + quotedText);
            }
            // Check the tarailing `"`.
            var end = length - 1;
            if (end <= offset || quotedText[end] != '"')
            {
                throw new FormatException("Invalid PO string: " + quotedText);
            }
            // Scan excluding the outer `"`.
            for (int i = offset + 1; i < end; i++)
            {
                var c = quotedText[i];
                if (c != '\\')
                {
                    sb.Append(c);
                    continue;
                }

                i++;
                if (i >= end)
                {
                    throw new FormatException("Invalid escape sequence: " + quotedText);
                }

                c = quotedText[i];
                switch (c)
                {
                    case 'a':
                        sb.Append('\a');
                        break;
                    case 'b':
                        sb.Append('\b');
                        break;
                    case 'f':
                        sb.Append('\f');
                        break;
                    case 'n':
                        sb.Append('\n');
                        break;
                    case 'r':
                        sb.Append('\r');
                        break;
                    case 't':
                        sb.Append('\t');
                        break;
                    case 'v':
                        sb.Append('\v');
                        break;
                    case '\\':
                        sb.Append('\\');
                        break;
                    case '"':
                        sb.Append('"');
                        break;
                    default:
                        throw new FormatException("Unknown PO escape sequence: \\" + c);
                }
            }
!!else!!
            unsafe
            {
                fixed (char* pQuotedText = quotedText)
                {
                    // Check the leading `"`.
                    if (offset >= length || pQuotedText[offset] != '"')
                    {
                        throw new FormatException("Invalid PO string: " + quotedText);
                    }
                    // Check the tarailing `"`.
                    var end = length - 1;
                    if (end <= offset || pQuotedText[end] != '"')
                    {
                        throw new FormatException("Invalid PO string: " + quotedText);
                    }
                    // Scan excluding the outer `"`.
                    for (int i = offset + 1; i < end; i++)
                    {
                        var c = pQuotedText[i];
                        if (c != '\\')
                        {
                            sb.Append(c);
                            continue;
                        }

                        i++;
                        if (i >= end)
                        {
                            throw new FormatException("Invalid escape sequence: " + quotedText);
                        }

                        c = pQuotedText[i];
                        switch (c)
                        {
                            case 'a':
                                sb.Append('\a');
                                break;
                            case 'b':
                                sb.Append('\b');
                                break;
                            case 'f':
                                sb.Append('\f');
                                break;
                            case 'n':
                                sb.Append('\n');
                                break;
                            case 'r':
                                sb.Append('\r');
                                break;
                            case 't':
                                sb.Append('\t');
                                break;
                            case 'v':
                                sb.Append('\v');
                                break;
                            case '\\':
                                sb.Append('\\');
                                break;
                            case '"':
                                sb.Append('"');
                                break;
                            default:
                                throw new FormatException("Unknown PO escape sequence: \\" + c);
                        }
                    }
                }
            }
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Pair of localization dictionary and the last modified time.
        /// </summary>
!!endif!!
        private sealed class LocalizationCache
        {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// <see cref="LocalizationAsset"/> instance.
            /// </summary>
!!endif!!
            public Dictionary<string, string> LocalizationDict { get; } = new Dictionary<string, string>();
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// File path.
            /// </summary>
!!endif!!
            public string FilePath { get; set; }
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Last write time of <see cref="FilePath"/>.
            /// </summary>
!!endif!!
            public DateTime LastWriteTime { get; set; }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Initialize <see cref="FilePath"/> and <see cref="LastWriteTime"/>.
            /// </summary>
            /// <param name="filePath">File path.</param>
!!endif!!
            public LocalizationCache(string filePath)
                : this(filePath, new FileInfo(filePath).LastWriteTime)
            {
            }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Initialize <see cref="FilePath"/> and <see cref="LastWriteTime"/>.
            /// </summary>
            /// <param name="filePath">File path.</param>
            /// <param name="lastWriteTime">Last write time of <paramref name="filePath"/>.</param>
!!endif!!
            public LocalizationCache(string filePath, DateTime lastWriteTime)
            {
                FilePath = filePath;
                LastWriteTime = lastWriteTime;
            }
        }
    }
}
