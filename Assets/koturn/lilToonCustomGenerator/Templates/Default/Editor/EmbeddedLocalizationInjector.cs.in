using System.Collections.Generic;
using System.Reflection;
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
!!  ifnotempty:SHOULD_EMIT_USING_LILTOON!!
using lilToon;
!!  endif!!
!!endif!!


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// <para>Additional language loader for <see cref="lilLanguageManager"/>.</para>
    /// </summary>
!!endif!!
    internal static class EmbeddedLocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback locale code.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!else!!
        private static readonly Dictionary<string, string> _loc = LilToonAdapter.LocDict;
!!endif!!
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Dictionary of localization dictionaries for each locale code.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, Dictionary<string, string>> _lozalizationDictDict = new Dictionary<string, Dictionary<string, string>>()
        {
            {
                "en-US", new Dictionary<string, string>()
                {
                    { "sCustomShaderTitle", "lilToon Custom" },
                    { "sCustomPropertyCategory", "lilToon Custom" },
                    %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                }
            },
            {
                "ja-JP", new Dictionary<string, string>()
                {
                    { "sCustomShaderTitle", "lilToon Custom" },
                    { "sCustomPropertyCategory", "lilToon Custom" },
                    %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                }
            },
            {
                "ka-KR", new Dictionary<string, string>()
                {
                    { "sCustomShaderTitle", "lilToon Custom" },
                    { "sCustomPropertyCategory", "lilToon Custom" },
                    %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                }
            },
            {
                "zh-Hans", new Dictionary<string, string>()
                {
                    { "sCustomShaderTitle", "lilToon Custom" },
                    { "sCustomPropertyCategory", "lilToon Custom" },
                    %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                }
            },
            {
                "zh-Hant", new Dictionary<string, string>()
                {
                    { "sCustomShaderTitle", "lilToon Custom" },
                    { "sCustomPropertyCategory", "lilToon Custom" },
                    %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                }
            },
        };


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language and inject it to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
!!endif!!
        public static void Load()
        {
!!ifempty:REQUIRE_ADAPTER_LANGUAGE_NAME!!
            Load(lilLanguageManager.langSet.languageName);
!!else!!
            Load(LilToonAdapter.LanguageName);
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language and inject it to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string langName)
        {
            if (_lozalizationDictDict.TryGetValue(ToLocaleCode(langName), out var localizationDict)
                || _lozalizationDictDict.TryGetValue(FallbackLocaleCode, out localizationDict))
            {
                InjectLocalizationDict(localizationDict);
            }
        }

!!ifempty:REQUIRE_ADAPTER_GET_LOC!!

!!  ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!  endif!!
        private static Dictionary<string, string> GetLoc()
        {
            return (Dictionary<string, string>)typeof(lilLanguageManager)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }
!!endif!!

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
        private static string ToLocaleCode(string langName)
        {
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Inject localization dictionary to <see cref="_loc"/>.
        /// </summary>
        /// <param name="localizationDict">Localization dictionary.</param>
!!endif!!
        private static void InjectLocalizationDict(Dictionary<string, string> localizationDict)
        {
            var loc = _loc;
            if (_lozalizationDictDict.TryGetValue(FallbackLocaleCode, out var fallbackLocalizationDict))
            {
                foreach (var kv in localizationDict)
                {
                    string val;
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        val = kv.Value;
                    }
                    else if (!fallbackLocalizationDict.TryGetValue(kv.Key, out val) || string.IsNullOrEmpty(val))
                    {
                        val = kv.Key;
                    }
                    loc[kv.Key] = val;
                }
            }
            else
            {
                foreach (var kv in localizationDict)
                {
                    loc[kv.Key] = kv.Value;
                }
            }
        }
    }
}
