using System.Collections.Generic;
using System.Reflection;
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
!!  ifnotempty:SHOULD_EMIT_USING_LILTOON!!
using lilToon;
!!  endif!!
!!endif!!


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// <para>Additional language loader for <see cref="lilLanguageManager"/>.</para>
    /// </summary>
!!endif!!
    internal static class EmbeddedLocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback locale code.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!else!!
        private static readonly Dictionary<string, string> _loc = LilToonAdapter.LocDict;
!!endif!!
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Dictionary of localization dictionaries for each locale code.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, Dictionary<string, string>> _lozalizationDictDict = BuildLocalizationDictDict();


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language and inject it to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
!!endif!!
        public static void Load()
        {
!!ifempty:REQUIRE_ADAPTER_LANGUAGE_NAME!!
            Load(lilLanguageManager.langSet.languageName);
!!else!!
            Load(LilToonAdapter.LanguageName);
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language and inject it to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string langName)
        {
            if (_lozalizationDictDict.TryGetValue(ToLocaleCode(langName), out var localizationDict)
                || _lozalizationDictDict.TryGetValue(FallbackLocaleCode, out localizationDict))
            {
                SetDictionary(localizationDict, _loc);
            }
        }

!!ifempty:REQUIRE_ADAPTER_GET_LOC!!

!!  ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!  endif!!
        private static Dictionary<string, string> GetLoc()
        {
            return (Dictionary<string, string>)typeof(lilLanguageManager)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }
!!endif!!

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
        private static string ToLocaleCode(string langName)
        {
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary without overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void AddDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target.TryAdd(kv.Key, kv.Value);
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary with overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void SetDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target[kv.Key] = kv.Value;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Build dictionary of localization dictionaries.
        /// </summary>
        /// <returns>Dictionary of localization dictionaries.</returns>
        /// <remarks>
        /// Edit this method when adding a translation.
        /// </remarks>
!!endif!!
        private static Dictionary<string, Dictionary<string, string>> BuildLocalizationDictDict()
        {
            var localizationDictDict = new Dictionary<string, Dictionary<string, string>>()
            {
                {
                    "en-US", new Dictionary<string, string>()
                    {
                        { "sCustomShaderTitle", "lilToon Custom" },
                        { "sCustomPropertyCategory", "lilToon Custom" },
                        %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                    }
                },
                {
                    "ja-JP", new Dictionary<string, string>()
                    {
                        { "sCustomShaderTitle", "lilToon Custom" },
                        { "sCustomPropertyCategory", "lilToon Custom" },
                        %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                    }
                },
                {
                    "ko-KR", new Dictionary<string, string>()
                    {
                        { "sCustomShaderTitle", "lilToon Custom" },
                        { "sCustomPropertyCategory", "lilToon Custom" },
                        %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                    }
                },
                {
                    "zh-Hans", new Dictionary<string, string>()
                    {
                        { "sCustomShaderTitle", "lilToon Custom" },
                        { "sCustomPropertyCategory", "lilToon Custom" },
                        %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                    }
                },
                {
                    "zh-Hant", new Dictionary<string, string>()
                    {
                        { "sCustomShaderTitle", "lilToon Custom" },
                        { "sCustomPropertyCategory", "lilToon Custom" },
                        %%LANGUAGE_DICTIONARY_KEY_VALUES:keepindent%%
                    }
                },
            };

            if (!localizationDictDict.TryGetValue(FallbackLocaleCode, out var fallbackLocalizationDict))
            {
                return localizationDictDict;
            }

            foreach (var localeCode in new[] { "ja-JP", "ko-KR", "zs-Hans", "zs-Hant" })
            {
                if (!localizationDictDict.TryGetValue(localeCode, out var localizationDict))
                {
                    continue;
                }
                AddDictionary(fallbackLocalizationDict, localizationDict);
            }

            return localizationDictDict;
        }
    }
}
