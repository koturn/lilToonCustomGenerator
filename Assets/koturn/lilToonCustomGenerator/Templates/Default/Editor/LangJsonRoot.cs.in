using System;
using UnityEngine;
!!ifnotempty:PRAGMA_WARNING_DISABLE_TOP!!

#pragma warning disable IDE0066 // Convert switch statement to expression
!!endif!!


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// Root object of localization json file.
    /// </summary>
!!endif!!
    [Serializable]
    public sealed class LangJsonRoot
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// All <see cref="LocalizationEntry"/> array.
        /// </summary>
!!endif!!
        public LocalizationEntry[] Entries => _entries ?? (_entries = new[] { en_US, ja_JP, ko_KR, zh_Hans, zh_Hant });
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="LocalizationEntry"/> instance.
        /// </summary>
!!endif!!
!!ifnotempty:SUPPRESS_MESSAGE_ATTRIBUTE_EACH_LOCATION!!
        [System.Diagnostics.CodeAnalysis.SuppressMessage("Style", "IDE0066:Convert switch statement to expression", Justification = "To support the C# 7.3 compiler (Unity 2018.3 ~ 2020.1), avoid using C# 8.0 features.")]
!!endif!!
        public LocalizationEntry this[string langName]
        {
            get
            {
!!ifnotempty:PRAGMA_WARNING_DISABLE_EACH_LOCATION!!
#pragma warning disable IDE0066 // Convert switch statement to expression
!!endif!!
                switch (langName)
                {
                    case "en-US":
                        return en_US;
                    case "ja-JP":
                        return ja_JP;
                    case "ko-KR":
                        return ko_KR;
                    case "zh-Hans":
                        return zh_Hans;
                    case "zh-Hant":
                        return zh_Hant;
                    default:
                        throw new InvalidOperationException("Language translation map not found: \"" + langName + "\"");
                }
!!ifnotempty:PRAGMA_WARNING_DISABLE_EACH_LOCATION!!
#pragma warning restore IDE0066 // Convert switch statement to expression
!!endif!!
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// <see cref="LocalizationEntry"/> for "en-US".
        /// </summary>
!!endif!!
        [SerializeField]
        private LocalizationEntry en_US;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// <see cref="LocalizationEntry"/> for "ja-JP".
        /// </summary>
!!endif!!
        [SerializeField]
        private LocalizationEntry ja_JP;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// <see cref="LocalizationEntry"/> for "ko-KR".
        /// </summary>
!!endif!!
        [SerializeField]
        private LocalizationEntry ko_KR;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// <see cref="LocalizationEntry"/> for "zh-Hans".
        /// </summary>
!!endif!!
        [SerializeField]
        private LocalizationEntry zh_Hans;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// <see cref="LocalizationEntry"/> for "zh-Hant".
        /// </summary>
!!endif!!
        [SerializeField]
        private LocalizationEntry zh_Hant;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// BAcking field of <see cref="Entries"/>.
        /// </summary>
!!endif!!
        private LocalizationEntry[] _entries;

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Hidden ctor.
        /// </summary>
!!endif!!
        [Obsolete("Should not be instanciated directly")]
        private LangJsonRoot()
        {
        }
    }
}
