using System;
using System.Collections.Generic;
using System.IO;
using System.Reflection;
using UnityEditor;
using UnityEngine;
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
!!  ifnotempty:SHOULD_EMIT_USING_LILTOON!!
using lilToon;
!!  endif!!
!!endif!!
!!ifnotempty:PRAGMA_WARNING_DISABLE_TOP!!

#pragma warning disable IDE0066 // Convert switch statement to expression
!!endif!!


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// <para>Additional language json file loader for <see cref="lilLanguageManager"/>.</para>
    /// <para>You must add language key as a members of <see cref="LocalizationEntry"/> when you add new translation.</para>
    /// </summary>
!!endif!!
    internal static class JsonLocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback locale code.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!else!!
        private static readonly Dictionary<string, string> _loc = LilToonAdapter.LocDict;
!!endif!!
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Language json instance.
        /// </summary>
!!endif!!
        private static LangJsonRoot _langJsonRoot;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Last loaded json file path.
        /// </summary>
!!endif!!
        private static string _lastLoadedJsonPath;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Last write time of the <see cref="_lastLoadedJsonPath"/>.
        /// </summary>
!!endif!!
        private static DateTime _lastWriteTime;


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language json file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidJson">GUID of language json file.</param>
!!endif!!
        public static void Load(string guidJson)
        {
!!ifempty:REQUIRE_ADAPTER_LANGUAGE_NAME!!
            Load(guidJson, lilLanguageManager.langSet.languageName);
!!else!!
            Load(guidJson, LilToonAdapter.LanguageName);
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language json file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidJson">GUID of portable object directory.</param>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string guidJson, string langName)
        {
            var jsonAssetPath = AssetDatabase.GUIDToAssetPath(guidJson);
            if (jsonAssetPath.Length == 0)
            {
                throw new FileNotFoundException("File not found; which is corresponding to GUID: " + guidJson);
            }

            var lastWriteTime = new FileInfo(jsonAssetPath).LastWriteTime;
            if (_lastWriteTime != lastWriteTime
                || _lastLoadedJsonPath != jsonAssetPath
                || _langJsonRoot == null)
            {
                var langJsonRoot = JsonUtility.FromJson<LangJsonRoot>(File.ReadAllText(jsonAssetPath));
                AddFallbackEntries(langJsonRoot);
                _langJsonRoot = langJsonRoot;
                _lastLoadedJsonPath = jsonAssetPath;
                _lastWriteTime = lastWriteTime;
            }

            var fallbakTranslation = _langJsonRoot[FallbackLocaleCode];
            var localeCode = ToLocaleCode(langName);
            if (localeCode == FallbackLocaleCode)
            {
                SetDictionary(fallbakTranslation.LocalizationDict, _loc);
                return;
            }

            var translation = _langJsonRoot[localeCode];
            if (translation == null)
            {
                if (fallbakTranslation == null)
                {
                    return;
                }
                translation = fallbakTranslation;
            }

            SetDictionary(translation.LocalizationDict, _loc);
        }

!!ifempty:REQUIRE_ADAPTER_GET_LOC!!

!!  ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!  endif!!
        private static Dictionary<string, string> GetLoc()
        {
            return (Dictionary<string, string>)typeof(lilLanguageManager)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }
!!endif!!

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
!!ifnotempty:SUPPRESS_MESSAGE_ATTRIBUTE_EACH_LOCATION!!
        [System.Diagnostics.CodeAnalysis.SuppressMessage("Style", "IDE0066:Convert switch statement to expression", Justification = "To support the C# 7.3 compiler (Unity 2018.3 ~ 2020.1), avoid using C# 8.0 features.")]
!!endif!!
        private static string ToLocaleCode(string langName)
        {
!!ifnotempty:PRAGMA_WARNING_DISABLE_EACH_LOCATION!!
#pragma warning disable IDE0066 // Convert switch statement to expression
!!endif!!
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
!!ifnotempty:PRAGMA_WARNING_DISABLE_EACH_LOCATION!!
#pragma warning restore IDE0066 // Convert switch statement to expression
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Add fallback entries to non-fallback localization dictionaries.
        /// </summary>
        /// <param name="localizationDictDict">Dictionary of lozalization dictionaries.</param>
!!endif!!
        private static void AddFallbackEntries(LangJsonRoot langJsonRoot)
        {
            var fallback = langJsonRoot[FallbackLocaleCode];
            if (fallback == null)
            {
                return;
            }

            foreach (var entry in langJsonRoot.Entries)
            {
                if (entry != null && entry != fallback)
                {
                    AddDictionary(fallback.LocalizationDict, entry.LocalizationDict);
                }
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary without overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void AddDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target.TryAdd(kv.Key, kv.Value);
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary with overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void SetDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target[kv.Key] = kv.Value;
            }
        }
    }
}
