// #define USE_EXPRESSION_TREE

using System;
using System.Collections.Generic;
using System.IO;
#if USE_EXPRESSION_TREE
using System.Linq.Expressions;
#endif  // USE_EXPRESSION_TREE
using System.Reflection;
#if !USE_EXPRESSION_TREE
using System.Reflection.Emit;
#endif  // !USE_EXPRESSION_TREE
using UnityEditor;
using UnityEngine;
using lilToon;


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// <para>Additional Portable Object file loader for <see cref="lilLanguageManager"/>.</para>
    /// <para>You must add language key as a members of <see cref="LocalizationEntry"/> when you add new translation.</para>
    /// </summary>
!!endif!!
    internal static partial class JsonLocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback locale code.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reflection result delegate to get current selected language name.
        /// </summary>
!!endif!!
        private static Func<string> _getLanguageName;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Language json instance.
        /// </summary>
!!endif!!
        private static LangJsonRoot _langJsonRoot;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Last loaded json file path.
        /// </summary>
!!endif!!
        private static string _lastLoadedJsonPath;
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Last write time of the <see cref="_lastLoadedJsonPath"/>.
        /// </summary>
!!endif!!
        private static DateTime _lastWriteTime;


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language json file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidJson">GUID of language json file.</param>
!!endif!!
        public static void Load(string guidJson)
        {
            Load(guidJson, GetLanguageName());
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load language json file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidJson">GUID of portable object directory.</param>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string guidJson, string langName)
        {
            var jsonAssetPath = AssetDatabase.GUIDToAssetPath(guidJson);
            if (jsonAssetPath.Length == 0)
            {
                throw new FileNotFoundException("File not found; which is corresponding to GUID: " + guidJson);
            }

            var lastWriteTime = new FileInfo(jsonAssetPath).LastWriteTime;
            if (_lastWriteTime != lastWriteTime
                || _lastLoadedJsonPath != jsonAssetPath
                || _langJsonRoot == null)
            {
                _langJsonRoot = JsonUtility.FromJson<LangJsonRoot>(File.ReadAllText(jsonAssetPath));
                _lastLoadedJsonPath = jsonAssetPath;
                _lastWriteTime = lastWriteTime;
            }

            var translation = _langJsonRoot[ToLocaleCode(langName)];
            if (translation == null)
            {
                translation = _langJsonRoot[FallbackLocaleCode];
                if (translation == null)
                {
                    return;
                }
            }

            InjectLocalizationDict(translation.LocalizationDict);
        }


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!endif!!
        private static Dictionary<string, string> GetLoc()
        {
            // lilLanguageManager implemented in lilToon 1.3.0.
            var tLilToonInspector = typeof(lilToonInspector);
            var tLilLanguageManager = tLilToonInspector.Assembly.GetType("lilToon.lilLanguageManager");
            return (Dictionary<string, string>)(tLilLanguageManager ?? tLilToonInspector)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get current selected language name.
        /// </summary>
        /// <returns>Selected language name.</returns>
!!endif!!
        private static string GetLanguageName()
        {
            return (_getLanguageName ?? (_getLanguageName = CreateGetLanguageNameFunc()))();
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilToonInspector.edSet.languageName</c> or <c>lilLanguageManager.langSet.languageName</c>.
        /// </summary>
        /// <returns>A delegate that returns current selected language name.</returns>
!!endif!!
        private static Func<string> CreateGetLanguageNameFunc()
        {
            var tLilToonInspector = typeof(lilToonInspector);
            var tLilLanguageManager = tLilToonInspector.Assembly.GetType("lilToon.lilLanguageManager");
            return tLilLanguageManager == null
                ? CreateGetLanguageNameFuncFromLilToonInspector(tLilToonInspector)
                : CreateGetLanguageNameFuncFromLilLanguageManager(tLilLanguageManager);
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilToonInspector.edSet.languageName</c>.
        /// </summary>
        /// <param name="tLilToonInspector"><c>typeof(lilToonInspector)</c></param>
        /// <returns>A delegate that returns <c>lilToonInspector.edSet.languageName</c>.</returns>
        /// <exception cref="MissingFieldException">Thrown when neither <c>lilToonInspector.edSet</c>
        /// nor <c>lilToonInspector.edSet.languageName</c> is found.</exception>
        /// <remarks>
        /// This method is intended for lilToon 1.2.11 and lilToon 1.2.12.
        /// </remarks>
!!endif!!
        private static Func<string> CreateGetLanguageNameFuncFromLilToonInspector(Type tLilToonInspector)
        {
            var fiEdSet = tLilToonInspector.GetField(
                "edSet",
                BindingFlags.Public | BindingFlags.Static);
            if (fiEdSet == null)
            {
                throw new MissingFieldException(tLilToonInspector.FullName, "edSet");
            }

            var tEdSet = fiEdSet.FieldType;
            var fiLanguageName = tEdSet.GetField(
                "languageName",
                BindingFlags.Public | BindingFlags.Instance);
            if (fiLanguageName == null)
            {
                throw new MissingFieldException(tEdSet.FullName, "languageName");
            }

#if USE_EXPRESSION_TREE
            return Expression.Lambda<Func<string>>(
                Expression.Field(
                    Expression.Field(
                        null,
                        fiEdSet),
                    fiLanguageName)).Compile();
#else
                var method = new DynamicMethod(
                    "GetLanguageName",
                    typeof(string),
                    Type.EmptyTypes,
                    typeof(JsonLocalizationInjector),
                    true);

                var il = method.GetILGenerator();

                il.Emit(OpCodes.Ldsfld, fiEdSet);
                il.Emit(OpCodes.Ldfld, fiLanguageName);
                il.Emit(OpCodes.Ret);

                return (Func<string>)method.CreateDelegate(typeof(Func<string>));
#endif  // USE_EXPRESSION_TREE
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Create delegate to get <c>lilLanguageManager.langSet.languageName</c>.
        /// </summary>
        /// <param name="tLilLanguageManager"><c>typeof(lilLanguageManager)</c></param>
        /// <returns>A delegate that returns <c>lilLanguageManager.langSet.languageName</c>.</returns>
        /// <exception cref="MissingMemberException">Thrown when neither <c>lilLanguageManager.langSet</c>
        /// nor <c>lilLanguageManager.langSet.languageName</c> is not found.</exception>
        /// <exception cref="MissingMethodException">Thrown when the getter method for <c>lilLanguageManager.langSet</c>
        /// or <c>lilLanguageManager.langSet.languageName</c> is not found.</exception>
        /// <remarks>
        /// This method is intended for lilToon 1.3.0 and later.
        /// </remarks>
!!endif!!
        private static Func<string> CreateGetLanguageNameFuncFromLilLanguageManager(Type tLilLanguageManager)
        {
            var langSetProperty = tLilLanguageManager.GetProperty(
                "langSet",
                BindingFlags.Public | BindingFlags.Static);
            if (langSetProperty == null)
            {
                throw new MissingMemberException(tLilLanguageManager.FullName, "langSet");
            }

            var tLanguageSettings = langSetProperty.PropertyType;
            var piLanguageName = tLanguageSettings.GetProperty(
                "languageName",
                BindingFlags.Public | BindingFlags.Instance);
            if (piLanguageName == null)
            {
                throw new MissingMemberException(tLanguageSettings.FullName, "languageName");
            }

#if USE_EXPRESSION_TREE
            return Expression.Lambda<Func<string>>(
                Expression.Property(
                    Expression.Property(
                        null,
                        langSetProperty),
                    piLanguageName),
                "GetLanguageName",
                null).Compile();
#else
                var langSetGetter = langSetProperty.GetGetMethod();
                if (langSetGetter == null)
                {
                    throw new MissingMethodException(tLilLanguageManager.FullName, "get_langSet");
                }

                var miLanguageNameGetter = piLanguageName.GetGetMethod();
                if (miLanguageNameGetter == null)
                {
                    throw new MissingMethodException(tLanguageSettings.FullName, "get_languageName");
                }

                var method = new DynamicMethod(
                    "GetLanguageName",
                    typeof(string),
                    Type.EmptyTypes,
                    typeof(JsonLocalizationInjector),
                    true);

                var il = method.GetILGenerator();

                il.Emit(OpCodes.Call, langSetGetter);
                il.Emit(OpCodes.Call, miLanguageNameGetter);
                il.Emit(OpCodes.Ret);

                return (Func<string>)method.CreateDelegate(typeof(Func<string>));
#endif
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
        private static string ToLocaleCode(string langName)
        {
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Inject localization dictionary to <see cref="_loc"/>.
        /// </summary>
        /// <param name="localizationDict">Localization dictionary.</param>
!!endif!!
        private static void InjectLocalizationDict(Dictionary<string, string> localizationDict)
        {
            var loc = _loc;
            var fallbackTranslationMap = _langJsonRoot[FallbackLocaleCode];
            if (fallbackTranslationMap != null)
            {
                var fallbackLocalizationDict = fallbackTranslationMap.LocalizationDict;
                foreach (var kv in localizationDict)
                {
                    string val;
                    if (!string.IsNullOrEmpty(kv.Value))
                    {
                        val = kv.Value;
                    }
                    else if (!fallbackLocalizationDict.TryGetValue(kv.Key, out val) || string.IsNullOrEmpty(val))
                    {
                        val = kv.Key;
                    }
                    loc[kv.Key] = val;
                }
            }
            else
            {
                foreach (var kv in localizationDict)
                {
                    loc[kv.Key] = kv.Value;
                }
            }
        }
    }
}
