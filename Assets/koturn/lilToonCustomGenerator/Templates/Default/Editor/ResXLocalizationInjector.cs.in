using System;
using System.Collections.Generic;
using System.IO;
using System.Reflection;
using System.Xml.Linq;
using UnityEditor;
using UnityEngine;
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
!!  ifnotempty:SHOULD_EMIT_USING_LILTOON!!
using lilToon;
!!  endif!!
!!endif!!


namespace %%NAMESPACE%%
{
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
    /// <summary>
    /// .resx language file loader for <see cref="lilLanguageManager"/>.
    /// </summary>
!!endif!!
    internal static class ResXLocalizationInjector
    {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Fallback language name.
        /// </summary>
!!endif!!
        private const string FallbackLocaleCode = "en-US";

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
!!ifempty:REQUIRE_ADAPTER_GET_LOC!!
        private static readonly Dictionary<string, string> _loc = GetLoc();
!!else!!
        private static readonly Dictionary<string, string> _loc = LilToonAdapter.LocDict;
!!endif!!
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cached reference to <c>lilLanguageManager.loc</c>.
        /// </summary>
!!endif!!
        private static readonly Dictionary<string, LocalizationCache> _cacheDict = new Dictionary<string, LocalizationCache>();


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load .resx language file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidResXDir">GUID of .resx file directory.</param>
!!endif!!
        public static void Load(string guidResXDir)
        {
!!ifempty:REQUIRE_ADAPTER_LANGUAGE_NAME!!
            Load(guidResXDir, lilLanguageManager.langSet.languageName);
!!else!!
            Load(guidResXDir, LilToonAdapter.LanguageName);
!!endif!!
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load .resx language file and inject its result to the language directory in <see cref="lilLanguageManager"/>.
        /// </summary>
        /// <param name="guidResXDir">GUID of .resx file directory.</param>
        /// <param name="langName">Target language name.</param>
!!endif!!
        public static void Load(string guidResXDir, string langName)
        {
            var dirAssetPath = AssetDatabase.GUIDToAssetPath(guidResXDir);

            // Load fallback.
            var shouldUpdate = TryLoadCache(
                dirAssetPath + "/Resources." + FallbackLocaleCode + ".resx",
                FallbackLocaleCode,
                out var fallbackCache);

            // If the target language is fallback, inject fallback dictionary and finish.
            var localeCode = ToLocaleCode(langName);
            if (localeCode == FallbackLocaleCode)
            {
                SetDictionary(fallbackCache.LocalizationDict, _loc);
                return;
            }

            // Load target language.
            shouldUpdate |= TryLoadCache(
                dirAssetPath + "/Resources." + localeCode + ".resx",
                localeCode,
                out var cache);

            // Insert fallback dictionary to the target dictionary if necessary.
            if (shouldUpdate)
            {
                AddDictionary(fallbackCache.LocalizationDict, cache.LocalizationDict);
            }

            SetDictionary(cache.LocalizationDict, _loc);
        }

!!ifempty:REQUIRE_ADAPTER_GET_LOC!!

!!  ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Get <see cref="lilLanguageManager"/>.loc using reflection.
        /// </summary>
        /// <returns>Localization dictionary in <see cref="lilLanguageManager"/> class.</returns>
!!  endif!!
        private static Dictionary<string, string> GetLoc()
        {
            return (Dictionary<string, string>)typeof(lilLanguageManager)
                .GetField(
                    "loc",
                    BindingFlags.NonPublic | BindingFlags.Static)
                .GetValue(null);
        }
!!endif!!

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Convert language name to locale code.
        /// </summary>
        /// <param name="langName">Target language name.</param>
        /// <returns>Locale code.</returns>
!!endif!!
        private static string ToLocaleCode(string langName)
        {
            switch (langName)
            {
                case "English":
                case "en-US":
                case "en_US":
                    return "en-US";
                case "Japanese":
                case "ja-JP":
                case "ja_JP":
                    return "ja-JP";
                case "Korean":
                case "ko-KR":
                case "ko_KR":
                    return "ko-KR";
                case "Chinese Simplified":
                case "zh-Hans":
                case "zh_Hans":
                    return "zh-Hans";
                case "Chinese Traditional":
                case "zh-Hant":
                case "zh_Hant":
                    return "zh-Hant";
                default:
                    return FallbackLocaleCode;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Try to load the cache.
        /// If the cache has not been created or the file has been updated, load the file and create the cache.
        /// </summary>
        /// <param name="fileAssetPath">.resx language asset file path.</param>
        /// <param name="localeCode">Locale code.</param>
        /// <param name="cache">Obtained cache data.</param>
        /// <returns>True if new data loaded, false otherwise.</returns>
!!endif!!
        private static bool TryLoadCache(string fileAssetPath, string localeCode, out LocalizationCache cache)
        {
            var fi = new FileInfo(fileAssetPath);

            if (_cacheDict.TryGetValue(localeCode, out cache))
            {
                if (!fi.Exists ||
                    (cache.LastWriteTime == fi.LastWriteTime && cache.FilePath == fi.FullName))
                {
                    return false;
                }
            }
            else
            {
                cache = new LocalizationCache();
            }

            if (fi.Exists)
            {
                LoadResX(fileAssetPath, cache.LocalizationDict);
                cache.FilePath = fi.FullName;
                cache.LastWriteTime = fi.LastWriteTime;
                _cacheDict[localeCode] = cache;
            }

            return true;
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Load .resx language file to the specified dictionary.
        /// </summary>
        /// <param name="fileAssetPath">.resx language asset file path.</param>
        /// <param name="localizationDict">Localization dictionary to load.</param>
        /// <exception cref="FileNotFoundException">Thrown when <paramref name="fileAssetPath"/> is not found.</exception>
!!endif!!
        private static void LoadResX(string fileAssetPath, Dictionary<string, string> localizationDict)
        {
            if (!File.Exists(fileAssetPath))
            {
                throw new FileNotFoundException(".resx language file not found", fileAssetPath);
            }

            var xdoc = XDocument.Load(fileAssetPath);

            localizationDict.Clear();
            foreach (var element in xdoc.Root.Elements("data"))
            {
                localizationDict[element.Attribute("name").Value] = element.Element("value").Value;
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary without overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void AddDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target.TryAdd(kv.Key, kv.Value);
            }
        }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Merge <paramref name="source"/> dictionary into <paramref name="target"/> dictionary with overwriting existing keys.
        /// </summary>
        /// <param name="source">Source dictionary.</param>
        /// <param name="target">Target dictionary.</param>
!!endif!!
        private static void SetDictionary(Dictionary<string, string> source, Dictionary<string, string> target)
        {
            foreach (var kv in source)
            {
                target[kv.Key] = kv.Value;
            }
        }


!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
        /// <summary>
        /// Cache information of the localization dictionary.
        /// </summary>
!!endif!!
        private sealed class LocalizationCache
        {
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// <see cref="LocalizationAsset"/> instance.
            /// </summary>
!!endif!!
            public Dictionary<string, string> LocalizationDict { get; } = new Dictionary<string, string>();
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// File path.
            /// </summary>
!!endif!!
            public string FilePath { get; set; }
!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Last write time of <see cref="FilePath"/>.
            /// </summary>
!!endif!!
            public DateTime LastWriteTime { get; set; }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Initialize with empty file information.
            /// </summary>
!!endif!!
            public LocalizationCache()
                : this(null, default)
            {
            }

!!ifnotempty:SHOULD_EMIT_DOC_COMMENTS!!
            /// <summary>
            /// Initialize <see cref="FilePath"/> and <see cref="LastWriteTime"/>.
            /// </summary>
            /// <param name="filePath">File path.</param>
            /// <param name="lastWriteTime">Last write time of <paramref name="filePath"/>.</param>
!!endif!!
            public LocalizationCache(string filePath, DateTime lastWriteTime)
            {
                FilePath = filePath;
                LastWriteTime = lastWriteTime;
            }
        }
    }
}
