!!ifnotempty:SHOULD_GENERATE_REFRESH_MENU!!

        [MenuItem("Assets/" + shaderName + "/Refresh shader cache", false, 2000)]
        private static void RefreshShaderCacheMenu()
        {
            var result = SafeNativeMethods.Open("Library/ShaderCache.db", out var pDb);
            if (result != 0)
            {
                Debug.LogErrorFormat("Failed to open Library/ShaderCache.db [{0}]", result);
                return;
            }

            try
            {
                result = SafeNativeMethods.Execute(pDb, "DELETE FROM shadererrors");
                if (result != 0)
                {
                    Debug.LogErrorFormat("SQL failed [{0}]", result);
                    return;
                }
            }
            finally
            {
                result = SafeNativeMethods.Close(pDb);
                if (result != 0)
                {
                    Debug.LogErrorFormat("Failed to close database [{0}]", result);
                }
            }

            var shaderDirPath = AssetDatabase.GUIDToAssetPath(GuidShaderDir);
            if (shaderDirPath.Length == 0)
            {
                Debug.LogWarning("Cannot find file or directory corresponding to GUID: " + GuidShaderDir);
                return;
            }
            if (!Directory.Exists(shaderDirPath))
            {
                Debug.LogWarningFormat("Directory not found: {0} ({1})", shaderDirPath, GuidShaderDir);
                return;
            }

            AssetDatabase.ImportAsset(shaderDirPath, ImportAssetOptions.ImportRecursive);

            var lilToonShaderDir = AssetDatabase.GUIDToAssetPath(GuidLilToonShaderDir);
            if (lilToonShaderDir.Length == 0)
            {
                Debug.LogWarningFormat("Shader directory of lilToon not found: {0}", GuidLilToonShaderDir);
                return;
            }
            AssetDatabase.ImportAsset(lilToonShaderDir, ImportAssetOptions.ImportRecursive);
        }

        [MenuItem("Assets/" + shaderName + "/Refresh shader cache", true)]
        private static bool ValidateRefreshShaderCacheMenu()
        {
            try
            {
                SafeNativeMethods.Close(IntPtr.Zero);
                return true;
            }
            catch (DllNotFoundException)
            {
                return false;
            }
        }
!!endif!!
!!ifnotempty:SUPPORT_PROPERTY_SEARCH!!

        private static bool ShouldDrawBlock(List<MaterialProperty> propertyList)
        {
            foreach (var property in propertyList)
            {
                if (lilEditorGUI.CheckPropertyToDraw(property))
                {
                    return true;
                }
            }
            return false;
        }
!!endif!!
!!ifnotempty:SHADER_KEYWORD_CASES!!

        private static bool IsAllShaderKeyword(string keyword)
        {
            switch (keyword)
            {
                %%SHADER_KEYWORD_CASES:keepindent%%
                    return true;
                default:
                    return false;
            }
        }
!!endif!!
!!ifnotempty:SHOULD_GENERATE_REFRESH_MENU!!


        [SuppressUnmanagedCodeSecurity]
        internal static class SafeNativeMethods
        {
#if UNITY_EDITOR && !UNITY_EDITOR_WIN
            private const string LibraryName = "sqlite3";
            private const CallingConvention CallConv = CallingConvention.Cdecl;
#else
            private const string LibraryName = "winsqlite3";
            private const CallingConvention CallConv = CallingConvention.StdCall;
#endif
            [DllImport(LibraryName, EntryPoint = "sqlite3_open16", ExactSpelling = true, CallingConvention = CallConv, CharSet = CharSet.Unicode)]
            public static extern int Open(string filePath, out IntPtr pDb);

            [DllImport(LibraryName, EntryPoint = "sqlite3_close", ExactSpelling = true, CallingConvention = CallConv)]
            public static extern int Close(IntPtr pDb);

            [DllImport(LibraryName, EntryPoint = "sqlite3_exec", ExactSpelling = true, CallingConvention = CallConv)]
            public static extern int Execute(IntPtr pDb, string sql, IntPtr pCallback = default(IntPtr), IntPtr pCallbackArg = default(IntPtr), IntPtr pErrMsg = default(IntPtr));
        }
!!endif!!
    }
}
#endif
